{
  "name": "@cosmicfut/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "COSMICFUT — servidor online autoritativo (Fastify + Socket.io)",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node --watch src/start.ts",
    "start": "node src/start.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bot": "node scripts/bot.ts",
    "bot:pvp": "node scripts/bot-pvp.ts"
  },
  "dependencies": {
    "@cosmicfut/engine": "^0.1.0",
    "@cosmicfut/online-core": "^0.1.0",
    "@cosmicfut/shared": "^0.1.0",
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "socket.io-client": "^4.8.4",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
