{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@cosmicfut/engine": ["../../packages/engine/src/index.ts"],
      "@cosmicfut/shared": ["../../packages/shared/src/index.ts"],
      "@cosmicfut/online-core/*": ["../../packages/online-core/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
